#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=10
start_service() {
    "${PAS_BIN:-/usr/bin/podkop-autoswitch}" recover || return 1
    config_load podkop-autoswitch
    local enabled
    config_get_bool enabled main enabled 0
    if [ "$enabled" = 1 ]; then
        procd_open_instance monitor
        procd_set_param command /usr/bin/podkop-autoswitch run
        procd_set_param file /etc/config/podkop-autoswitch
        procd_set_param respawn 3600 5 5
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
    fi
    # Import and isolated checks must work before enabling routing management.
    procd_open_instance updater
    procd_set_param command /usr/bin/podkop-autoswitch updater
    procd_set_param file /etc/config/podkop-autoswitch
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
service_triggers() {
    procd_add_reload_trigger podkop-autoswitch
}

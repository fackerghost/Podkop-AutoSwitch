config settings 'main'
	option enabled '1'
	option section 'main'
	option interval '5'
	option failure_threshold '3'
	option timeout_ms '1500'
	option cooldown '30'
	option auto_switch '1'
	option update_interval '3600'
	option recovery_retry '10'
	option outage_refresh '60'
	option max_nodes '64'
	option max_bytes '1048576'
	option data_check '1'
	option data_url 'https://www.cloudflare.com/cdn-cgi/trace'
	option qualify_url 'https://speed.cloudflare.com/__down?bytes=16384'
	option qualify_attempts '4'
	option qualify_successes '2'
	option parallel_checks '3'
	list test_url 'https://www.gstatic.com/generate_204'
	list test_url 'https://cp.cloudflare.com/generate_204'

